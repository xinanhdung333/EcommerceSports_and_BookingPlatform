                        <a href="tel:19001234" class="block text-center bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold py-2 px-3 rounded-lg transition-colors">
                            <i class="fa-solid fa-phone text-xs mr-1"></i> 1900 1234
                        </a>
                    </div>

                </div>
            </aside>

