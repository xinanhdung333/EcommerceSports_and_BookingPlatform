                                <i class="fa-solid fa-circle-check text-xs"></i>
                            </div>
                        </div>
                        <div class="flex items-baseline justify-between">
                            <span class="text-2xl font-extrabold text-emerald-600" id="confirmedCount">3</span>
                            <span class="text-[11px] font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">Đang chuẩn bị</span>
