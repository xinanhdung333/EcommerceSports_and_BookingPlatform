                        </div>
                        <input type="text" id="globalSearchInput" placeholder="Tìm sân, dịch vụ căng vợt, dụng cụ thể thao..." class="w-full bg-transparent px-4 py-2 text-sm text-white placeholder-slate-400 focus:outline-none">
