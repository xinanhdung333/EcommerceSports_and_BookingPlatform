    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-2xl border border-slate-700 flex items-center gap-3 text-xs transform translate-y-20 opacity-0 transition-all duration-300">
        <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
        <span id="toastMsg">Thao tác thành công!</span>
