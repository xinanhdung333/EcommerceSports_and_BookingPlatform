                        </div>
                    </div>

                    <!-- Pending Processing -->
                    <div onclick="filterByStatus('pending')" class="stat-card cursor-pointer bg-white p-4 rounded-2xl border border-slate-200/80 hover:border-amber-400 hover:shadow-md transition-all group">
                        <div class="flex items-center justify-between mb-2">
