        }
        .badge-pulse {
            box-shadow: 0 0 0 0 rgba(234, 179, 8, 0.7);
            animation: pulse-ring 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
        }
        @keyframes pulse-ring {
            to {
                box-shadow: 0 0 0 8px rgba(234, 179, 8, 0);
            }
        }
    </style>
</head>
