    <!-- JAVASCRIPT CONTROLLERS -->
    <script>
        // Tab Filtering logic
        function setActiveTab(status) {
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-slate-900', 'text-white', 'font-bold');
                btn.classList.add('text-slate-600', 'hover:bg-slate-100');
            });

            const activeBtn = document.getElementById(`tab-${status}`);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');
                activeBtn.classList.add('bg-slate-900', 'text-white', 'font-bold');
            }

            filterByStatus(status);
        }

        function filterByStatus(status) {
            const cards = document.querySelectorAll('.order-card');
            cards.forEach(card => {
                if (status === 'all') {
                    card.classList.remove('hidden');
                } else {
                    if (card.getAttribute('data-status') === status) {
                        card.classList.remove('hidden');
                    } else {
                        card.classList.add('hidden');
                    }
                }
            });
        }

        // Live text filter
        function filterOrders() {
            const keyword = document.getElementById('filterKeyword').value.toLowerCase();
            const payment = document.getElementById('paymentFilter').value;
            const clearBtn = document.getElementById('clearSearchBtn');

            clearBtn.classList.toggle('hidden', keyword === '');

            const cards = document.querySelectorAll('.order-card');
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                const cardPayment = card.getAttribute('data-payment');

                const matchesKeyword = text.includes(keyword);
                const matchesPayment = (payment === 'all' || cardPayment === payment);

                if (matchesKeyword && matchesPayment) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        function clearSearch() {
            document.getElementById('filterKeyword').value = '';
            filterOrders();
        }

        // Grid / List View Switcher
        function setViewMode(mode) {
            const container = document.getElementById('ordersContainer');
            const gridBtn = document.getElementById('viewGridBtn');
            const listBtn = document.getElementById('viewListBtn');

            if (mode === 'grid') {
                container.className = 'grid grid-cols-1 md:grid-cols-2 gap-5';
                gridBtn.className = 'px-2.5 py-1 rounded-lg bg-white text-slate-900 shadow-sm font-semibold transition-all';
                listBtn.className = 'px-2.5 py-1 rounded-lg text-slate-500 hover:text-slate-900 transition-all';
            } else {
                container.className = 'grid grid-cols-1 gap-4';
                listBtn.className = 'px-2.5 py-1 rounded-lg bg-white text-slate-900 shadow-sm font-semibold transition-all';
                gridBtn.className = 'px-2.5 py-1 rounded-lg text-slate-500 hover:text-slate-900 transition-all';
            }
        }

        // Modals Logic
        function openOrderDetailModal(code) {
            const modal = document.getElementById('orderModal');
            const container = document.getElementById('modalContainer');
            document.getElementById('modalOrderTitle').innerText = `Chi tiết đơn hàng #${code}`;

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                container.classList.remove('scale-95');
            }, 10);
        }

        function closeModal() {
            const modal = document.getElementById('orderModal');
            const container = document.getElementById('modalContainer');
            modal.classList.add('opacity-0');
            container.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        function openPaymentModal(code, amount) {
            const modal = document.getElementById('paymentModal');
            document.getElementById('payModalCode').innerText = `#${code}`;
            document.getElementById('payModalAmount').innerText = amount;

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);
        }

        function closePaymentModal() {
            const modal = document.getElementById('paymentModal');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        function confirmPaymentSuccess() {
            closePaymentModal();
            showToast('Đã ghi nhận thông tin chuyển khoản! SportsHub sẽ xác nhận trong 5 phút.');
        }

        // Copy Clipboard Helper
        function copyToClipboard(text) {
            const tempInput = document.createElement('input');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast(`Đã sao chép mã vận đơn: ${text}`);
        }

        function trackShipping(code) {
            showToast(`Đang kết nối tới đối tác giao hàng GHN (Mã: ${code})...`);
        }

        function handleSearch() {
            const q = document.getElementById('globalSearchInput').value;
            if(q.trim() !== '') {
                showToast(`Đang tìm kiếm dịch vụ: "${q}"`);
            }
        }

        function refreshData() {
            const icon = document.getElementById('refreshIcon');
            icon.classList.add('fa-spin');
            setTimeout(() => {
                icon.classList.remove('fa-spin');
                showToast('Dữ liệu dịch vụ đã được cập nhật mới nhất!');
            }, 800);
        }

        // Toast Helper
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
