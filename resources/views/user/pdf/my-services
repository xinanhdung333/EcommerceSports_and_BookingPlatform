    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fffbe1',
                            100: '#fff3b8',
                            400: '#facc15',
                            500: '#eab308',
                            600: '#ca8a04',
                            dark: '#0f172a',
                            navy: '#1e293b'
                        }
                    }
                }
            }
        }
    </script>
    <style>
